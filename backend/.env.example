# ---- Required ----

# MongoDB connection string
#   Local:  mongodb://localhost:27017/bedmanager
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bedmanager
MONGO_URI=mongodb://localhost:27017/bedmanager

# Secret used to sign login tokens. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# ---- Optional ----

PORT=5001
NODE_ENV=development

# Extra origins allowed to call the API (comma separated). Not needed when the
# frontend and API share an origin, as in the single-project Vercel setup.
# FRONTEND_URL=https://your-frontend.example.com

# FastAPI ML microservice (see ml-service/). Without it, predictions come from
# statistical estimates based on the hospital's historical data.
# ML_SERVICE_URL=http://localhost:8000

# SMTP settings for emailing reports
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
