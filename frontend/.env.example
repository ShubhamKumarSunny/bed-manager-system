# All variables are optional. With none set, the app calls the API on its own
# origin (/api): Vite proxies it to the local backend in development, and on
# Vercel the API runs as a serverless function in the same project.

# Backend used by the Vite dev-server proxy (default: http://localhost:5001)
# VITE_DEV_BACKEND_URL=http://localhost:5001

# Only when the API is hosted on a different origin than the frontend:
# VITE_API_BASE_URL=https://your-backend.example.com/api

# Only when a long-running backend with Socket.IO is available in production
# (Render, Railway, ...). Without it the app falls back to polling.
# VITE_SOCKET_URL=https://your-backend.example.com
